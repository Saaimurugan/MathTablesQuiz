# ── Node ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Capacitor web build output ────────────────────
# www/ is a copy of the source files — not a real build artifact,
# but if you want to exclude it:
# www/

# ── Android build outputs ─────────────────────────
# (covered by android/.gitignore, but belt-and-suspenders)
android/app/build/
android/build/
*.apk
*.aab

# ── OS & editor noise ─────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── VS Code ───────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Python cache (used for QR generation) ─────────
__pycache__/
*.pyc

# ── Temp downloads (JDK/SDK zips) ─────────────────
*.zip
*.msi

# ── Keystore — never commit signing keys ──────────
*.jks
*.keystore
release-key.*
